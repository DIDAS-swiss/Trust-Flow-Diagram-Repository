// Generic Verifiable Credential — Issuance & Verification — LikeC4 model
//
// Models a typical verifiable-credential ecosystem: a Holder (using a
// wallet app), an Issuer, a Verifier, and a shared Trust Infrastructure
// made up of a Base Registry (technical: keys & revocation status) and a
// Trust Registry (legal: who is actually accredited to issue/verify).
//
// The "over 18" check is used as a concrete example of a selective-
// disclosure verification, but the pattern is generic and applies to any
// verifiable credential.
//
// Render "registration", "issuance" and "verification" as SEQUENCE diagrams:
//   - Playground (playground.likec4.dev): paste this file, open the view,
//     toggle the "Sequence" variant in the view controls
//   - CLI: likec4 export png --sequence -f "registration|issuance|verification" .
//   - VS Code: install the LikeC4 extension, open Preview, switch variant
//
// Technical protocol/format details (grant types, claim paths, JWT types...)
// live in the `notes` of each step, with a plain-language explanation
// attached. Step titles stay readable on their own.

specification {
  element actor {
    style {
      shape person
      color green
    }
  }
  element system {
    style {
      shape rectangle
    }
  }
  element database {
    style {
      shape cylinder
      color indigo
    }
  }
}

model {
  holder = actor 'Holder' 'Citizen using the swiyu Wallet app'

  issuer = system 'Issuer' 'Organization issuing verifiable credentials, via an OID4VCI service' {
    style {
      color amber
    }
  }

  verifier = system 'Verifier' 'Relying party (e.g. an online shop) — OID4VP service' {
    style {
      color secondary
    }
  }

  confederation = system 'Federal Trust-Infrastructure' 'Federal trust infrastructure operated by FOITT' {
    style {
      color indigo
      opacity 10%
      border solid
      icon bootstrap:bank
    }

    baseRegistry = database 'Base Registry' 'DIDs, public keys, DID Documents, Token Status Lists' {
      style {
        icon bootstrap:key
      }
    }

    trustRegistry = database 'Trust Registry' 'Links DIDs to accredited legal identities (validated by a Trust Authority)' {
      style {
        icon bootstrap:patch-check
      }
    }
  }

  // Baseline relationships, used by the landscape/overview view
  holder -> issuer 'requests & receives credential '{
      navigateTo issuance
  }
  issuer -> baseRegistry 'publishes DID + public key, updates revocation status'
  issuer -> trustRegistry 'applies for and holds issuer accreditation'
  verifier -> baseRegistry 'publishes DID + public key, resolves issuer DID, checks status'
  verifier -> trustRegistry 'applies for accreditation, checks issuer/verifier trust'
  holder -> verifier 'presents credential for a check'{
      navigateTo verification
  }
  issuer -> confederation 'registers DID & gets accredited' {
      navigateTo registration
  }
  verifier -> confederation 'resolves DIDs, checks status & accreditation'
}

views {

  view index {
    title 'Verifiable Credential Trust Infrastructure — Overview'
    include *
  }

  // Scoped view for the trust infrastructure container. Because this is
  // the only view "of trustInfrastructure", it becomes its default view —
  // clicking the "Trust Infrastructure" box in the index view (or any
  // other view) navigates here automatically, expanding it into
  // Base Registry + Trust Registry.
  view trustInfrastructureDetail of confederation {
    title 'Trust Infrastructure — Base Registry & Trust Registry'
    include baseRegistry, trustRegistry, confederation, issuer, holder, verifier
  }

  dynamic view registration {
    title 'Registration & Trust Setup — Sequence'

    issuer -> baseRegistry 'Publish issuer key' {
      notes '''
        **Protocol:** HTTPS
        **Format:** did:webvh log file (a DID Document, JSON-LD)

        The Issuer generates an ES256 keypair and publishes a DID
        (Decentralized Identifier) plus the matching public key. This
        is purely technical — the Base Registry has no idea yet that
        this key "belongs to" the Issuer, it just records "this DID
        exists and this is its current public key."
      '''
    }

    issuer -> trustRegistry 'Apply for issuer accreditation' {
      notes '''
        **Protocol:** HTTPS/REST (an administrative/legal process,
        not yet OID4VCI)

        The Issuer requests official recognition as a trusted
        credential issuer. A Trust Authority reviews the request and
        validates the Issuer's legal identity before approving it.
      '''
    }

    trustRegistry -> issuer 'Trust Statement issued' {
      notes '''
        **Format:** W3C Verifiable Credential, signed by the Trust
        Authority

        This document binds the Issuer's DID (the technical key from
        the previous step) to its real-world legal identity — e.g.
        "this DID = [Issuer's legal name], accredited credential
        issuer." Anyone can look this up later to confirm a signature
        genuinely comes from the legitimate issuer, not just any
        keypair.
      '''
    }

    verifier -> baseRegistry 'Publish verifier key' {
      notes '''
        **Protocol:** HTTPS
        **Format:** did:webvh log file (DID Document)

        Same idea as for the issuer: the verifier (e.g. an online
        shop) generates its own keypair and publishes its DID and
        public key.
      '''
    }

    verifier -> trustRegistry 'Apply for verifier accreditation, defines what data he will request for which purpose' {
      notes '''
        **Protocol:** HTTPS/REST (administrative process)

        The verifier requests recognition as an accredited relying
        party, so wallets can later show users a trustworthy name
        instead of a raw, anonymous DID.

        Also the verifier needs to declare the data he will request and the purpose for it.
      '''
    }

    trustRegistry -> verifier 'Trust Statement issued' {
      notes '''
        **Format:** W3C Verifiable Credential, signed by the Trust
        Authority

        Binds the verifier's DID to its legal identity, e.g. "this
        DID = [Verifier's legal name], accredited verifier."
      '''
    }

    include issuer, verifier, baseRegistry, trustRegistry, confederation
  }

  dynamic view issuance {
    title 'Credential Issuance — Sequence'

    holder -> issuer 'Verify identity' {
      notes '''
        **Out-of-band, no OID4VCI yet.** The Holder proves who they
        are to the Issuer — e.g. in person, or remotely by scanning
        an existing ID document together with a biometric check. The
        Issuer verifies the identity and assembles the attributes
        that will later go into the credential (e.g. name, date of
        birth, a derived age_over_18 flag, etc.).
      '''
    }

    issuer -> holder 'Send credential offer (QR / link)' {
      notes '''
        **Protocol:** OID4VCI
        **Format:** JSON "Credential Offer" object, delivered as an
        `openid-credential-offer://` deep link (same device) or a QR
        code (cross device)

        It is called a "credential offer" because the issuer is not
        handing over the credential yet — it is only telling the
        wallet which credential is available and how to fetch it. The
        offer carries a `pre-authorized_code`: a one-time code
        already tied to the identity check from the previous step, so
        the wallet does not need a separate login.
      '''
    }

    holder -> trustRegistry 'Check the Issuer is accredited' {
      notes '''
        **Protocol:** HTTPS/REST   **Format:** Trust Statement (VC)

        Optional, but recommended: the wallet looks up the Issuer's
        Trust Statement and can show "Verified issuer: [Organization
        Name]" before the holder accepts the offer.
      '''
    }

    holder -> issuer 'Request an access token' {
      notes '''
        **Protocol:** OAuth 2.0 token endpoint, over HTTPS
        **Format:** JSON

        The wallet redeems the pre-authorized code from the offer.
        `grant_type=pre-authorized_code` is the standard OAuth 2.0 way
        of saying "I hold this one-time code, please exchange it for
        an access token." An optional transaction PIN can be required
        here too.
      '''
    }

    issuer -> holder 'Return access token' {
      notes '''**Format:** JSON, `access_token` field — used to authorize the next request.'''
    }

    holder -> issuer 'Request the credential' {
      notes '''
        **Protocol:** OID4VCI Credential Request
        **Format:** JSON, containing a JWT "proof"

        Before asking for the credential, the wallet generates a
        fresh ES256 keypair in secure on-device storage and signs a
        small proof-of-possession JWT with it. This proves to the
        Issuer that the wallet controls that key. The Issuer will
        embed its public half into the credential as the "cnf"
        (confirmation / holder-binding) key, so the credential can
        later be cryptographically tied to this specific wallet.
      '''
    }

    issuer -> holder 'Issue the credential' {
      notes '''
        **Protocol:** OID4VCI, over HTTPS/JSON
        **Format:** SD-JWT VC
        **Signed by:** the Issuer, ES256 — matching the public key
        published on the Base Registry during registration

        Each disclosable claim (name, birthdate, age_over_18, ...) is
        replaced in the signed body by a salted hash digest (an
        "_sd" array). The actual (salt, name, value) triples are sent
        separately as "Disclosures". This separation is exactly what
        later lets the wallet reveal only some claims, with no need
        to go back to the Issuer.
      '''
    }

    issuer -> baseRegistry 'Publish revocation status entry' {
      notes '''
        **Format:** Token Status List — a signed JWT bit-array
        **Signed by:** the Issuer, hosted (not signed) by the Base
        Registry, so a verifier can check revocation later without
        ever contacting the Issuer directly.
      '''
    }

    include holder, issuer, trustRegistry, baseRegistry, confederation
  }

  dynamic view verification {
    title 'Credential Verification — "Over 18?" example — Sequence'

    verifier -> holder 'Request proof of age (over 18)' {
      notes '''
        **Protocol:** OID4VP, via an `openid4vp://` deep link or QR
        code
        **Format:** signed JWT (Authorization Request Object)
        wrapping a DIF Presentation Definition

        The request asks specifically for a credential type (e.g.
        `vct=identity-credential`) and the field `$.age_over_18` — a
        boolean computed by the Issuer at issuance time, never the
        raw date of birth. It also carries a random `nonce` and the
        verifier's DID as `client_id`, both used later to block
        replay attacks.
      '''
    }

    holder -> baseRegistry 'Check requester signature' {
      notes '''
        **Protocol:** HTTPS   **Format:** DID Document

        The wallet resolves the verifier's DID to get its public key,
        and checks that the request was really signed by that key —
        not tampered with or spoofed.
      '''
    }

    holder -> trustRegistry 'Check requester is accredited and checks if the requested data coresponds with the declared purpose' {
      notes '''
        **Protocol:** HTTPS/REST   **Format:** Trust Statement (VC)

        Lets the wallet show "[Verifier Name] — verified merchant" so
        the holder can give informed consent before sharing anything.

        Furthermore the requested data is compared to the declared purpose and data statement made by the verifier at registration. 
      '''
    }

    holder -> verifier 'Send proof (only "over 18")' {
      notes '''
        **Protocol:** OID4VP, `response_mode=direct_post` (an HTTPS
        POST straight back to the verifier)
        **Format:** SD-JWT VC + exactly one Disclosure (age_over_18)
        + a "Key Binding JWT" (kb-jwt)
        **Signed by:** the holder's device key, inside the kb-jwt —
        over the nonce, the verifier's client_id, and a hash of the
        SD-JWT. This proves the presenter actually holds the bound
        key and blocks replay of a captured presentation.

        Every other Disclosure (name, birthdate, address, ...) is
        simply left out — the verifier never even receives them.
      '''
    }

    verifier -> baseRegistry 'Check issuer signature' {
      notes '''
        **Protocol:** HTTPS   **Format:** DID Document

        The verifier resolves the Issuer's DID to get its public key,
        and checks the issuer's signature on the SD-JWT body —
        proving the credential is authentic and untampered.
      '''
    }

    verifier -> baseRegistry 'Check credential is not revoked' {
      notes '''**Protocol:** HTTPS   **Format:** signed Token Status List'''
    }

    verifier -> trustRegistry 'Check issuer is still accredited ' {
      notes '''
        **Protocol:** HTTPS/REST   **Format:** Trust Statement (VC)

        Without this step, a valid signature only proves "some
        keypair signed this." The Trust Registry is what proves that
        keypair really belongs to the legitimate, accredited Issuer.
      '''
    }

    include holder, verifier, baseRegistry, trustRegistry, confederation
  }
}
